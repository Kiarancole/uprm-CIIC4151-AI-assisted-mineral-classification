{
  "protocol_version": "1.0",
  "seed": 42,
  "groups": ["high", "medium", "low"],
  "models": ["resnet18", "efficientnet_b0", "efficientnet_b3"],
  "data": {
    "image_size": 224,
    "batch_size": 16,
    "num_workers": 2,
    "cache_pad_color": [124, 116, 104],
    "normalization_mean": [0.485, 0.456, 0.406],
    "normalization_std": [0.229, 0.224, 0.225],
    "augmentation": {
      "horizontal_flip_probability": 0.5,
      "vertical_flip_probability": 0.5,
      "rotation_degrees": 10,
      "rotation_fill": [124, 116, 104]
    }
  },
  "training": {
    "epochs": 20,
    "optimizer": "adamw",
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "scheduler": "cosine",
    "loss": "balanced_cross_entropy",
    "selection_metric": "macro_f1",
    "mixed_precision": true
  },
  "evaluation": {
    "latency_samples": 100,
    "calibration_bins": 10,
    "top_k": [1, 3]
  },
  "priority_weights": {
    "high": 0.5,
    "medium": 0.3,
    "low": 0.2
  },
  "selection": {
    "pws_tie_margin": 0.02,
    "high_group_minimum_worst_class_recall": 0.70
  },
  "success_thresholds": {
    "macro_f1_minimum": 0.80,
    "per_class_precision_minimum": 0.80,
    "per_class_recall_minimum": 0.80,
    "cross_group_standard_deviation_maximum": 0.10,
    "top3_accuracy_minimum": 0.85,
    "expected_calibration_error_maximum": 0.10,
    "cpu_inference_mean_seconds_maximum": 3.0
  }
}
